
alert icmp any any -> any any (msg:"NIDS ALERT - ICMP Ping Detected"; sid:1000001; rev:1;)

alert tcp any any -> any any (msg:"NIDS ALERT - Possible TCP SYN Scan"; flags:S; flow:stateless; sid:1000002; rev:1;)

alert http any any -> any any (msg:"NIDS ALERT - Suspicious HTTP Sensitive Path Access"; flow:established,to_server; http.uri; content:"/admin"; sid:1000003; rev:1;)
